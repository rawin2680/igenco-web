# ==============================================================================
# Environment Configuration — IGENCO AI
# ==============================================================================

# Global Environment (development / production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Frontend (Nuxt 3)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
FRONTEND_USE_MOCK=true # Set to 'true' to use mock data during Frontend-First phase, 'false' when Strapi is ready

# ------------------------------------------------------------------------------
# Backend (Strapi v5)
# ------------------------------------------------------------------------------
STRAPI_PORT=1337
STRAPI_URL=http://localhost:1337
STRAPI_APP_KEYS="igencoAppKey1,igencoAppKey2"
STRAPI_API_TOKEN_SALT="igencoApiTokenSalt32CharactersMin"
STRAPI_ADMIN_JWT_SECRET="igencoAdminJwtSecretKey32CharsMin"
STRAPI_TRANSFER_TOKEN_SALT="igencoTransferTokenSalt32CharsMin"
STRAPI_JWT_SECRET="igencoJwtSecretKey32CharactersMin"

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# หากใช้ container postgres ใน docker-compose ให้คงค่า DB_HOST=postgres
# หากใช้ PostgreSQL ภายนอกหรือ Docker เดิมที่มีอยู่แล้ว ให้แก้เป็น IP หรือ host.docker.internal
DB_HOST=postgres
DB_PORT=5432
DB_NAME=igenco_db
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass
DB_SSL=false
