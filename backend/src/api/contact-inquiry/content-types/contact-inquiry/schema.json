{
  "kind": "collectionType",
  "collectionName": "contact_inquiries",
  "info": {
    "singularName": "contact-inquiry",
    "pluralName": "contact-inquiries",
    "displayName": "Contact Inquiry (ข้อมูลติดต่อและนัด Demo)",
    "description": "รายการผู้ติดต่อขอใบเสนอราคาและนัดหมายสาธิตระบบจากหน้าเว็บ"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "contactName": {
      "type": "string",
      "required": true
    },
    "organization": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "subject": {
      "type": "string"
    },
    "interestedProduct": {
      "type": "string"
    },
    "details": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "contacted", "closed"],
      "default": "new"
    }
  }
}
