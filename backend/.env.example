# Strapi Backend Environment Variables
HOST=0.0.0.0
PORT=1337

# Secrets (generate with `openssl rand -base64 32`)
APP_KEYS="igencoAppKey1,igencoAppKey2"
API_TOKEN_SALT="igencoApiTokenSalt32CharactersMin"
ADMIN_JWT_SECRET="igencoAdminJwtSecretKey32CharsMin"
TRANSFER_TOKEN_SALT="igencoTransferTokenSalt32CharsMin"
JWT_SECRET="igencoJwtSecretKey32CharactersMin"

# Database (PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=igenco_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secure_pass
DATABASE_SSL=false

# Railway / production
# PUBLIC_URL=https://<your-backend>.up.railway.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}   (Railway reference variable)
# FRONTEND_URL=https://igenco-demo2.vercel.app

# Passwords for the seeded /admin portal accounts (required in production,
# the account is skipped when unset)
# SEED_SYSADMIN_EMAIL=sysadmin@igenco.co.th
# SEED_SYSADMIN_PASSWORD=
# SEED_EDITOR_EMAIL=editor@igenco.co.th
# SEED_EDITOR_PASSWORD=
